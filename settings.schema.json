{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Configuration for orbit.nvim modules.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "modules": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "additionalProperties": false,
          "description": "Settings command integration.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Register the settings command.",
              "type": "boolean"
            },
            "name": {
              "default": "OrbitSettings",
              "description": "Command name.",
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "default": "",
              "description": "Optional settings path override.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "corekeys": {
          "additionalProperties": false,
          "description": "Core file and window navigation mappings.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Register the core mappings.",
              "type": "boolean"
            },
            "save": {
              "default": "<C-s>",
              "description": "Save the current buffer.",
              "minLength": 1,
              "type": "string"
            },
            "window_down": {
              "default": "<C-j>",
              "description": "Focus the lower window.",
              "minLength": 1,
              "type": "string"
            },
            "window_left": {
              "default": "<C-h>",
              "description": "Focus the left window.",
              "minLength": 1,
              "type": "string"
            },
            "window_right": {
              "default": "<C-l>",
              "description": "Focus the right window.",
              "minLength": 1,
              "type": "string"
            },
            "window_up": {
              "default": "<C-k>",
              "description": "Focus the upper window.",
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "editor": {
          "additionalProperties": false,
          "description": "Core editor options applied on startup.",
          "properties": {
            "autoread": {
              "default": true,
              "description": "Detect changes made to files outside Neovim.",
              "type": "boolean"
            },
            "clipboard": {
              "default": "unnamedplus",
              "description": "Use the system clipboard as unnamed register.",
              "type": "string"
            },
            "cursorlineopt": {
              "default": "number",
              "description": "Highlight the cursor line number.",
              "enum": [
                "line",
                "screenline",
                "number",
                "both"
              ],
              "type": "string"
            },
            "enabled": {
              "default": true,
              "description": "Apply configured editor options.",
              "type": "boolean"
            },
            "expandtab": {
              "default": true,
              "description": "Insert spaces instead of tab characters.",
              "type": "boolean"
            },
            "fileformats": {
              "default": "unix,dos",
              "description": "Accept Unix and DOS file endings.",
              "type": "string"
            },
            "laststatus": {
              "default": 3,
              "description": "Use one global status line.",
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            "mouse": {
              "default": "a",
              "description": "Enable mouse input across modes.",
              "enum": [
                "",
                "a",
                "n",
                "v"
              ],
              "type": "string"
            },
            "number": {
              "default": true,
              "description": "Show absolute line numbers.",
              "type": "boolean"
            },
            "numberwidth": {
              "default": 2,
              "description": "Set minimum line number width.",
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            "relativenumber": {
              "default": true,
              "description": "Show relative line numbers.",
              "type": "boolean"
            },
            "ruler": {
              "default": false,
              "description": "Hide the redundant cursor ruler.",
              "type": "boolean"
            },
            "shiftwidth": {
              "default": 2,
              "description": "Number of spaces used for indentation.",
              "maximum": 16,
              "minimum": 0,
              "type": "integer"
            },
            "showmode": {
              "default": false,
              "description": "Hide the extra mode indicator.",
              "type": "boolean"
            },
            "signcolumn": {
              "default": "yes",
              "description": "Keep the sign column visible.",
              "enum": [
                "yes",
                "no",
                "auto"
              ],
              "type": "string"
            },
            "smartindent": {
              "default": true,
              "description": "Enable automatic indentation.",
              "type": "boolean"
            },
            "splitkeep": {
              "default": "screen",
              "description": "Preserve screen text while splitting.",
              "enum": [
                "screen",
                "cursor",
                "topline"
              ],
              "type": "string"
            },
            "tabstop": {
              "default": 2,
              "description": "Display width of a tab character.",
              "maximum": 16,
              "minimum": 1,
              "type": "integer"
            },
            "undofile": {
              "default": true,
              "description": "Persist undo history between sessions.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "events": {
          "additionalProperties": false,
          "description": "Standalone core Neovim events.",
          "properties": {
            "diagnostics_redraw": {
              "default": true,
              "description": "Redraw the statusline when diagnostics change.",
              "type": "boolean"
            },
            "directory_argument": {
              "default": true,
              "description": "Change directory for a directory startup argument.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "enabled": {
              "default": true,
              "description": "Enable core event behavior.",
              "type": "boolean"
            },
            "filepost": {
              "default": true,
              "description": "Emit a one-shot FilePost event when a normal file is ready.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "startup_buffer": {
              "default": true,
              "description": "Keep a listed unnamed buffer behind startup interfaces.",
              "type": "boolean",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "filetypes": {
          "additionalProperties": false,
          "description": "Filename and extension detection rules.",
          "properties": {
            "compose": {
              "default": "yaml.docker-compose",
              "description": "Filetype for Compose YAML filenames.",
              "minLength": 1,
              "type": "string"
            },
            "enabled": {
              "default": true,
              "description": "Register custom filetype detections.",
              "type": "boolean"
            },
            "jsx": {
              "default": "jsx",
              "description": "Filetype for JSX extensions.",
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "git": {
          "additionalProperties": false,
          "description": "Lazy gitsigns integration.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Include gitsigns in the plugin specs.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "marks": {
              "additionalProperties": false,
              "default": {},
              "description": "Unstaged change markers.",
              "properties": {
                "add": {
                  "default": "▎",
                  "description": "Added line marker.",
                  "type": "string"
                },
                "change": {
                  "default": "▎",
                  "description": "Changed line marker.",
                  "type": "string"
                },
                "changedelete": {
                  "default": "▎",
                  "description": "Changed-and-deleted marker.",
                  "type": "string"
                },
                "delete": {
                  "default": "",
                  "description": "Deleted line marker.",
                  "type": "string"
                },
                "topdelete": {
                  "default": "",
                  "description": "Top-deleted line marker.",
                  "type": "string"
                },
                "untracked": {
                  "default": "▎",
                  "description": "Untracked line marker.",
                  "type": "string"
                }
              },
              "type": "object",
              "x-orbit-restart": true
            },
            "staged": {
              "additionalProperties": false,
              "default": {},
              "description": "Staged change markers.",
              "properties": {
                "add": {
                  "default": " ",
                  "description": "Staged addition marker.",
                  "type": "string"
                },
                "change": {
                  "default": " ",
                  "description": "Staged modification marker.",
                  "type": "string"
                },
                "changedelete": {
                  "default": "▎",
                  "description": "Staged changed-and-deleted marker.",
                  "type": "string"
                },
                "delete": {
                  "default": " ",
                  "description": "Staged deletion marker.",
                  "type": "string"
                },
                "topdelete": {
                  "default": "",
                  "description": "Staged top-deletion marker.",
                  "type": "string"
                }
              },
              "type": "object",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "icons": {
          "additionalProperties": false,
          "description": "Optional mini.icons integration.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Include mini.icons in the Lazy specification.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "mock_devicons": {
              "default": true,
              "description": "Provide an nvim-web-devicons compatibility adapter.",
              "type": "boolean",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "keymaps": {
          "additionalProperties": false,
          "description": "Minimal key mappings owned by orbit.nvim.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Register the module mappings.",
              "type": "boolean"
            },
            "leader": {
              "default": " ",
              "description": "Leader key set before module mappings.",
              "minLength": 1,
              "type": "string"
            },
            "save": {
              "default": "<leader>w",
              "description": "Normal-mode mapping that writes the current buffer.",
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "plugins": {
          "additionalProperties": false,
          "description": "On-demand Lazy plugin initialization.",
          "properties": {
            "bootstrap": {
              "default": false,
              "description": "Clone Lazy on first demand when missing.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "enabled": {
              "default": false,
              "description": "Enable plugin initialization for this session.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "import": {
              "default": "plugins",
              "description": "Lazy plugin spec import module.",
              "minLength": 1,
              "type": "string",
              "x-orbit-restart": true
            },
            "lockfile": {
              "default": "",
              "description": "Optional locked revision file.",
              "type": "string",
              "x-orbit-restart": true
            },
            "path": {
              "default": "",
              "description": "Optional existing lazy.nvim installation directory.",
              "type": "string",
              "x-orbit-restart": true
            },
            "source": {
              "default": "https://github.com/folke/lazy.nvim.git",
              "description": "Git source for Lazy bootstrap.",
              "minLength": 1,
              "type": "string",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "title": "orbit.nvim settings",
  "type": "object"
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Configuration for orbit.nvim modules.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "modules": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "additionalProperties": false,
          "description": "Settings command integration.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Register the settings command.",
              "type": "boolean"
            },
            "name": {
              "default": "OrbitSettings",
              "description": "Command name.",
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "default": "",
              "description": "Optional settings path override.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "corekeys": {
          "additionalProperties": false,
          "description": "Core file and window navigation mappings.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Register the core mappings.",
              "type": "boolean"
            },
            "save": {
              "default": "<C-s>",
              "description": "Save the current buffer.",
              "minLength": 1,
              "type": "string"
            },
            "window_down": {
              "default": "<C-j>",
              "description": "Focus the lower window.",
              "minLength": 1,
              "type": "string"
            },
            "window_left": {
              "default": "<C-h>",
              "description": "Focus the left window.",
              "minLength": 1,
              "type": "string"
            },
            "window_right": {
              "default": "<C-l>",
              "description": "Focus the right window.",
              "minLength": 1,
              "type": "string"
            },
            "window_up": {
              "default": "<C-k>",
              "description": "Focus the upper window.",
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "diagnostics_plugins": {
          "additionalProperties": false,
          "description": "Trouble and todo-comments integrations.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Contribute diagnostic plugin specifications.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "preview_border": {
              "default": "rounded",
              "description": "Diagnostic preview border.",
              "enum": [
                "rounded",
                "single",
                "double",
                "solid",
                "shadow",
                "none"
              ],
              "type": "string",
              "x-orbit-restart": true
            },
            "preview_height_percent": {
              "default": 30,
              "description": "Diagnostic preview height percentage.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "x-orbit-restart": true
            },
            "preview_width_percent": {
              "default": 30,
              "description": "Diagnostic preview width percentage.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "x-orbit-restart": true
            },
            "todo": {
              "default": true,
              "description": "Enable todo-comments integration.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "todo_icon": {
              "default": " ",
              "description": "WORKAROUND marker icon.",
              "minLength": 1,
              "type": "string",
              "x-orbit-restart": true
            },
            "trouble": {
              "default": true,
              "description": "Enable Trouble diagnostics views.",
              "type": "boolean",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "editor": {
          "additionalProperties": false,
          "description": "Core editor options applied on startup.",
          "properties": {
            "autoread": {
              "default": true,
              "description": "Detect changes made to files outside Neovim.",
              "type": "boolean"
            },
            "clipboard": {
              "default": "unnamedplus",
              "description": "Use the system clipboard as unnamed register.",
              "type": "string"
            },
            "cursorlineopt": {
              "default": "number",
              "description": "Highlight the cursor line number.",
              "enum": [
                "line",
                "screenline",
                "number",
                "both"
              ],
              "type": "string"
            },
            "enabled": {
              "default": true,
              "description": "Apply configured editor options.",
              "type": "boolean"
            },
            "expandtab": {
              "default": true,
              "description": "Insert spaces instead of tab characters.",
              "type": "boolean"
            },
            "fileformats": {
              "default": "unix,dos",
              "description": "Accept Unix and DOS file endings.",
              "type": "string"
            },
            "laststatus": {
              "default": 3,
              "description": "Use one global status line.",
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            "mouse": {
              "default": "a",
              "description": "Enable mouse input across modes.",
              "enum": [
                "",
                "a",
                "n",
                "v"
              ],
              "type": "string"
            },
            "number": {
              "default": true,
              "description": "Show absolute line numbers.",
              "type": "boolean"
            },
            "numberwidth": {
              "default": 2,
              "description": "Set minimum line number width.",
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            "relativenumber": {
              "default": true,
              "description": "Show relative line numbers.",
              "type": "boolean"
            },
            "ruler": {
              "default": false,
              "description": "Hide the redundant cursor ruler.",
              "type": "boolean"
            },
            "shiftwidth": {
              "default": 2,
              "description": "Number of spaces used for indentation.",
              "maximum": 16,
              "minimum": 0,
              "type": "integer"
            },
            "showmode": {
              "default": false,
              "description": "Hide the extra mode indicator.",
              "type": "boolean"
            },
            "signcolumn": {
              "default": "yes",
              "description": "Keep the sign column visible.",
              "enum": [
                "yes",
                "no",
                "auto"
              ],
              "type": "string"
            },
            "smartindent": {
              "default": true,
              "description": "Enable automatic indentation.",
              "type": "boolean"
            },
            "splitkeep": {
              "default": "screen",
              "description": "Preserve screen text while splitting.",
              "enum": [
                "screen",
                "cursor",
                "topline"
              ],
              "type": "string"
            },
            "tabstop": {
              "default": 2,
              "description": "Display width of a tab character.",
              "maximum": 16,
              "minimum": 1,
              "type": "integer"
            },
            "undofile": {
              "default": true,
              "description": "Persist undo history between sessions.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "editor_plugins": {
          "additionalProperties": false,
          "description": "Optional editor visual integrations.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Contribute editor plugin specifications.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "indent_char": {
              "default": "│",
              "description": "Indentation marker.",
              "minLength": 1,
              "type": "string",
              "x-orbit-restart": true
            },
            "indent_guides": {
              "default": true,
              "description": "Enable indent-blankline.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "matchup": {
              "default": true,
              "description": "Enable vim-matchup.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "matchup_stopline": {
              "default": 500,
              "description": "Matchup syntax scan limit.",
              "minimum": 0,
              "type": "integer",
              "x-orbit-restart": true
            },
            "scope_char": {
              "default": "│",
              "description": "Scope marker.",
              "minLength": 1,
              "type": "string",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "events": {
          "additionalProperties": false,
          "description": "Standalone core Neovim events.",
          "properties": {
            "diagnostics_redraw": {
              "default": true,
              "description": "Redraw the statusline when diagnostics change.",
              "type": "boolean"
            },
            "directory_argument": {
              "default": true,
              "description": "Change directory for a directory startup argument.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "enabled": {
              "default": true,
              "description": "Enable core event behavior.",
              "type": "boolean"
            },
            "filepost": {
              "default": true,
              "description": "Emit a one-shot FilePost event when a normal file is ready.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "startup_buffer": {
              "default": true,
              "description": "Keep a listed unnamed buffer behind startup interfaces.",
              "type": "boolean",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "filetypes": {
          "additionalProperties": false,
          "description": "Filename and extension detection rules.",
          "properties": {
            "compose": {
              "default": "yaml.docker-compose",
              "description": "Filetype for Compose YAML filenames.",
              "minLength": 1,
              "type": "string"
            },
            "enabled": {
              "default": true,
              "description": "Register custom filetype detections.",
              "type": "boolean"
            },
            "jsx": {
              "default": "jsx",
              "description": "Filetype for JSX extensions.",
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "formatter": {
          "additionalProperties": false,
          "description": "Conform formatting integration.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Enable Conform formatting.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "format_on_save": {
              "default": false,
              "description": "Format automatically when writing.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "key": {
              "default": "<leader>fm",
              "description": "Manual format mapping.",
              "minLength": 1,
              "type": "string",
              "x-orbit-restart": true
            },
            "lsp_format": {
              "default": "fallback",
              "description": "LSP formatting fallback strategy.",
              "enum": [
                "fallback",
                "never",
                "first",
                "last"
              ],
              "type": "string",
              "x-orbit-restart": true
            },
            "timeout_ms": {
              "default": 5000,
              "description": "Formatter timeout in milliseconds.",
              "maximum": 60000,
              "minimum": 100,
              "type": "integer",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "git": {
          "additionalProperties": false,
          "description": "Lazy gitsigns integration.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Include gitsigns in the plugin specs.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "marks": {
              "additionalProperties": false,
              "default": {},
              "description": "Unstaged change markers.",
              "properties": {
                "add": {
                  "default": "▎",
                  "description": "Added line marker.",
                  "type": "string"
                },
                "change": {
                  "default": "▎",
                  "description": "Changed line marker.",
                  "type": "string"
                },
                "changedelete": {
                  "default": "▎",
                  "description": "Changed-and-deleted marker.",
                  "type": "string"
                },
                "delete": {
                  "default": "",
                  "description": "Deleted line marker.",
                  "type": "string"
                },
                "topdelete": {
                  "default": "",
                  "description": "Top-deleted line marker.",
                  "type": "string"
                },
                "untracked": {
                  "default": "▎",
                  "description": "Untracked line marker.",
                  "type": "string"
                }
              },
              "type": "object",
              "x-orbit-restart": true
            },
            "staged": {
              "additionalProperties": false,
              "default": {},
              "description": "Staged change markers.",
              "properties": {
                "add": {
                  "default": " ",
                  "description": "Staged addition marker.",
                  "type": "string"
                },
                "change": {
                  "default": " ",
                  "description": "Staged modification marker.",
                  "type": "string"
                },
                "changedelete": {
                  "default": "▎",
                  "description": "Staged changed-and-deleted marker.",
                  "type": "string"
                },
                "delete": {
                  "default": " ",
                  "description": "Staged deletion marker.",
                  "type": "string"
                },
                "topdelete": {
                  "default": "",
                  "description": "Staged top-deletion marker.",
                  "type": "string"
                }
              },
              "type": "object",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "icons": {
          "additionalProperties": false,
          "description": "Optional mini.icons integration.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Include mini.icons in the Lazy specification.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "mock_devicons": {
              "default": true,
              "description": "Provide an nvim-web-devicons compatibility adapter.",
              "type": "boolean",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "keymaps": {
          "additionalProperties": false,
          "description": "Minimal key mappings owned by orbit.nvim.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Register the module mappings.",
              "type": "boolean"
            },
            "leader": {
              "default": " ",
              "description": "Leader key set before module mappings.",
              "minLength": 1,
              "type": "string"
            },
            "save": {
              "default": "<leader>w",
              "description": "Normal-mode mapping that writes the current buffer.",
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "mason": {
          "additionalProperties": false,
          "description": "Lazy Mason package manager integration.",
          "properties": {
            "enabled": {
              "default": true,
              "description": "Enable Mason commands.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "installed_icon": {
              "default": " ",
              "description": "Installed package icon.",
              "type": "string",
              "x-orbit-restart": true
            },
            "max_concurrent_installers": {
              "default": 10,
              "description": "Concurrent package installation limit.",
              "maximum": 64,
              "minimum": 1,
              "type": "integer",
              "x-orbit-restart": true
            },
            "path_mode": {
              "default": "skip",
              "description": "Mason PATH handling policy.",
              "enum": [
                "skip",
                "prepend",
                "append"
              ],
              "type": "string",
              "x-orbit-restart": true
            },
            "pending_icon": {
              "default": " ",
              "description": "Pending package icon.",
              "type": "string",
              "x-orbit-restart": true
            },
            "registry": {
              "default": "github:mason-org/mason-registry",
              "description": "Primary Mason registry.",
              "minLength": 1,
              "type": "string",
              "x-orbit-restart": true
            },
            "uninstalled_icon": {
              "default": " ",
              "description": "Uninstalled package icon.",
              "type": "string",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "plugins": {
          "additionalProperties": false,
          "description": "On-demand Lazy plugin initialization.",
          "properties": {
            "bootstrap": {
              "default": false,
              "description": "Clone Lazy on first demand when missing.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "enabled": {
              "default": false,
              "description": "Enable plugin initialization for this session.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "import": {
              "default": "plugins",
              "description": "Lazy plugin spec import module.",
              "minLength": 1,
              "type": "string",
              "x-orbit-restart": true
            },
            "lockfile": {
              "default": "",
              "description": "Optional locked revision file.",
              "type": "string",
              "x-orbit-restart": true
            },
            "path": {
              "default": "",
              "description": "Optional existing lazy.nvim installation directory.",
              "type": "string",
              "x-orbit-restart": true
            },
            "source": {
              "default": "https://github.com/folke/lazy.nvim.git",
              "description": "Git source for Lazy bootstrap.",
              "minLength": 1,
              "type": "string",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "snacks": {
          "additionalProperties": false,
          "description": "Snacks UI and picker integration.",
          "properties": {
            "bigfile": {
              "default": true,
              "description": "Enable large-file handling.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "dashboard": {
              "default": true,
              "description": "Enable dashboard.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "enabled": {
              "default": true,
              "description": "Include Snacks in Lazy specs.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "input": {
              "default": true,
              "description": "Enable input prompts.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "notifier": {
              "default": true,
              "description": "Enable notifier.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "notify_timeout": {
              "default": 3000,
              "description": "Notification timeout in milliseconds.",
              "minimum": 0,
              "type": "integer",
              "x-orbit-restart": true
            },
            "picker": {
              "default": true,
              "description": "Enable picker.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "quickfile": {
              "default": true,
              "description": "Enable quickfile.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "scope": {
              "default": true,
              "description": "Enable scope detection.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "scroll": {
              "default": true,
              "description": "Enable smooth scroll.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "statuscolumn": {
              "default": true,
              "description": "Enable status column.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "words": {
              "default": true,
              "description": "Enable word references.",
              "type": "boolean",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        },
        "treesitter_plugins": {
          "additionalProperties": false,
          "description": "Tree-sitter parser and companion plugins.",
          "properties": {
            "autotag": {
              "default": true,
              "description": "Enable HTML/XML auto tags.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "autotag_close": {
              "default": true,
              "description": "Insert closing tags.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "autotag_close_slash": {
              "default": false,
              "description": "Close tags after slash.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "autotag_rename": {
              "default": true,
              "description": "Rename matching tags.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "context": {
              "default": true,
              "description": "Enable Tree-sitter context view.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "context_lines": {
              "default": 3,
              "description": "Context line limit.",
              "maximum": 50,
              "minimum": 0,
              "type": "integer",
              "x-orbit-restart": true
            },
            "core": {
              "default": true,
              "description": "Install the main parser manager.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "enabled": {
              "default": true,
              "description": "Include Tree-sitter plugin specs.",
              "type": "boolean",
              "x-orbit-restart": true
            },
            "install_dir": {
              "default": "",
              "description": "Optional parser installation directory.",
              "type": "string",
              "x-orbit-restart": true
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "title": "orbit.nvim settings",
  "type": "object"
}
